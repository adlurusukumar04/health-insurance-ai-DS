# ─────────────────────────────────────────────────────────────────────────────
# .env.example — Health Insurance AI Platform
# Copy to .env and fill in values. NEVER commit .env to git.
# ─────────────────────────────────────────────────────────────────────────────

# Application
APP_ENV=dev           # dev | staging | prod
DEBUG=false
LOG_LEVEL=info

# API Server
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=2
CORS_ORIGINS=*        # Restrict in production: https://your-domain.com

# Database (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=health_insurance_ai
DB_USER=postgres
DB_PASSWORD=change_me_in_production

# AWS
AWS_DEFAULT_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_key_here
AWS_SECRET_ACCESS_KEY=your_secret_here
AWS_ACCOUNT_ID=123456789012
S3_BUCKET=health-insurance-ai-data
S3_PREFIX=raw
SAGEMAKER_ROLE=arn:aws:iam::123456789012:role/SageMakerExecutionRole

# Azure ML (if using Azure instead of AWS)
AZURE_SUBSCRIPTION_ID=
AZURE_RESOURCE_GROUP=
AZURE_ML_WORKSPACE=

# Model Settings
FRAUD_MODEL_VERSION=latest
APPROVAL_MODEL_VERSION=latest
FRAUD_THRESHOLD=0.55
MODEL_DIR=models/saved
RETRAIN_AUC_DROP=0.03
PSI_WARNING=0.10
PSI_CRITICAL=0.25
FPR_ALERT=0.10

# HIPAA Compliance
HIPAA_MODE=true
ANON_SALT=change-this-to-a-secret-random-string-in-production
PHI_ENC_KEY=                         # AES-256 key for PHI encryption (base64)
AUDIT_LOG=logs/audit.jsonl

# Airflow (if running locally)
AIRFLOW__CORE__EXECUTOR=LocalExecutor
AIRFLOW__DATABASE__SQL_ALCHEMY_CONN=postgresql+psycopg2://airflow:airflow@localhost/airflow
AIRFLOW__CORE__FERNET_KEY=           # Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"

# Notifications
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/xxx/yyy/zzz
ALERT_EMAIL=ds-alerts@your-org.com
